{
    "name": "ojooss/gkeepapi-php",
    "description": "PHP port of kiwiz/gkeepapi - unofficial Google Keep client",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Gkeepapi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gkeepapi\\Tests\\": "tests/",
            "Gkeepapi\\Tools\\": "tools/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "rector-fix": "rector process",
        "stan": "phpstan analyse --memory-limit=1G",
        "cs": "phpcs",
        "cs-fix": "phpcbf",
        "quality": [
            "@test",
            "@rector-fix",
            "@stan",
            "@cs"
        ],
        "live-check": "php tools/live-check.php",
        "master-token": "php tools/master-token.php"
    },
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.0",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "keywords": [
        "google keep",
        "keep",
        "gkeepapi",
        "notes",
        "psr-18"
    ],
    "suggest": {
        "ext-curl": "Needed for the bundled Gkeepapi\\Http\\CurlHttpClient (HTTP/1.1 without ALPN, as Google expects)",
        "nyholm/psr7": "A PSR-7/PSR-17 implementation (the library only needs the interfaces)"
    }
}
